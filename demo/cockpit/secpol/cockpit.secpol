# Channel rules for cockpit, generated by blueprint secpol from blueprint.yaml.
# Only the processes in the contract are covered. Merge this into the policy
# for the whole system (secpolgenerate gives a starting point), compile it
# with secpolcompile and start each process with its type, e.g.
#   on -T gps_t gps

type gps_t;
type nav_t;
type camera_t;
type logger_t;
type display_t;

allow_attach gps_t /dev/name/local/cockpit-gps;
allow_attach nav_t /dev/name/local/cockpit-nav;
allow_attach camera_t /dev/name/local/cockpit-camera;
allow_attach logger_t /dev/name/local/cockpit-logger;

# nav -> gps
allow nav_t gps_t:channel connect;
# nav -> logger
allow nav_t logger_t:channel connect;
# display -> camera
allow display_t camera_t:channel connect;
# display -> logger
allow display_t logger_t:channel connect;
# display -> nav
allow display_t nav_t:channel connect;
